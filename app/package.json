{
  "name": "stirling-pdf-app",
  "version": "0.1.0",
  "description": "Electron desktop wrapper around Stirling-PDF",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "build": "electron-builder"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.17.0"
  },
  "build": {
    "appId": "com.imachinethings.stirlingpdfapp",
    "productName": "Stirling PDF",
    "files": [
      "main.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../backend/Stirling-PDF.jar",
        "to": "Stirling-PDF.jar"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
